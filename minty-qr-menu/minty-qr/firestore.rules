rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /artifacts/{appId}/public/data/{document=**} {
      // Müşteriler anonim giriş yapar; giriş yapmış herkes okuyup yazabilir.
      // Not: Bu kurallar PIN'in istemci tarafında olması nedeniyle gevşektir (README'ye bakın).
      allow read, write: if request.auth != null;
    }
  }
}
